PORT=6002
APP_URL=http://localhost:6002
KAILA_SOCKET_BEARER_TOKEN=change_this_before_deployment

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kaila_mvp
KAILA_AUTO_CONFIRM_HOURS=48
KAILA_RATING_WINDOW_DAYS=7
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Optional social login/signup.
# Google uses the web OAuth client ID. Facebook uses app ID plus app secret so
# the server can validate browser access tokens before creating/login users.
KAILA_GOOGLE_CLIENT_ID=
KAILA_FACEBOOK_APP_ID=
KAILA_FACEBOOK_APP_SECRET=

# Native Android APK update prompt.
# Optional fallback/manual settings. Normal Android releases keep the stable
# Drive link in tracked socket/mobile-update.json, which Gradle rewrites with a
# fresh versionCode/versionName during APK/AAB builds.
KAILA_ANDROID_APK_URL=https://drive.google.com/file/d/1FG0o6--zWQpmqYkqszSSDJVuivwzf89L/view?usp=drive_link
KAILA_ANDROID_RELEASE_NOTES=
KAILA_ANDROID_LATEST_VERSION_CODE=
KAILA_ANDROID_LATEST_VERSION_NAME=

# Firebase Cloud Messaging for native Android push notifications.
# Use either GOOGLE_APPLICATION_CREDENTIALS pointing to a service-account JSON file
# or paste that JSON into FIREBASE_SERVICE_ACCOUNT_JSON.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional WebRTC TURN settings for reliable audio/video calls on mobile networks.
# Use either KAILA_RTC_ICE_SERVERS JSON or the simpler KAILA_TURN_* fields.
# KAILA_RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":["turn:turn.example.com:3478?transport=udp","turn:turn.example.com:3478?transport=tcp"],"username":"user","credential":"pass"}]
KAILA_TURN_URLS=
KAILA_TURN_USERNAME=
KAILA_TURN_CREDENTIAL=
